# Spanish text for the Tahoe Neighborhood Table website.
# Keep this file up to date with: python manage.py translations update
msgid ""
msgstr ""
"Project-Id-Version: Tahoe Neighborhood Table\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: static/site/js/accounts.js
msgid "Logging in…"
msgstr "Iniciando sesión…"

#: static/site/js/accounts.js
msgid "This form has expired. Reload the page and try again."
msgstr "Este formulario venció. Vuelva a cargar la página e inténtelo de nuevo."

#: static/site/js/accounts.js
msgid "Too many tries. Wait a minute, then try again."
msgstr "Demasiados intentos. Espere un minuto y vuelva a intentarlo."

#: static/site/js/accounts.js
msgid "Something went wrong. Try again."
msgstr "Algo salió mal. Inténtelo de nuevo."

#: static/site/js/accounts.js
msgid "Couldn't reach the website. Check your connection and try again."
msgstr "No se pudo conectar con el sitio web. Revise su conexión e inténtelo de nuevo."

#: static/site/js/site.js
msgid "We believe everyone deserves a seat at the table."
msgstr "Creemos que todos merecen un asiento en la mesa."

#: static/site/js/site.js
msgid "We believe everyone deserves a warm place to be."
msgstr "Creemos que todos merecen un lugar cálido donde estar."

#: static/site/js/site.js
msgid "We believe everyone deserves a place to call home."
msgstr "Creemos que todos merecen un lugar al que llamar hogar."

#: static/site/js/site.js
msgid "Nourishing our community. Building hope."
msgstr "Alimentando a nuestra comunidad. Construyendo esperanza."

#: static/site/js/site.js
msgid "Join Tahoe Neighborhood Table:"
msgstr "Únase a Tahoe Neighborhood Table:"

#: static/site/js/site.js
msgid "Press Ctrl+C or ⌘C to copy the selected text."
msgstr "Presione Ctrl+C o ⌘C para copiar el texto seleccionado."

#: static/site/js/site.js
msgid "Copied. Paste it anywhere."
msgstr "Copiado. Péguelo donde quiera."

#: static/site/js/site.js
msgid "Email address copied."
msgstr "Correo electrónico copiado."

#: static/site/js/site.js
msgid "Copied"
msgstr "Copiado"

#: static/site/js/site.js
msgid "Copy"
msgstr "Copiar"

#: static/site/js/site.js
msgid "Press Ctrl+C or ⌘C to copy the selected address."
msgstr "Presione Ctrl+C o ⌘C para copiar la dirección seleccionada."

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "%s shift"
msgid_plural "%s shifts"
msgstr[0] "%s turno"
msgstr[1] "%s turnos"

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "%s hour"
msgid_plural "%s hours"
msgstr[0] "%s hora"
msgstr[1] "%s horas"

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "%s hours"
msgstr "%s horas"

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "%(role)s, %(day)s at %(time)s"
msgstr "%(role)s, %(day)s, %(time)s"

#: volunteers/static/volunteers/volunteer.js
msgid "Already started"
msgstr "Ya empezó"

#: volunteers/static/volunteers/volunteer.js
msgid "Full"
msgstr "Completo"

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "%(left)s of %(total)s spot left"
msgid_plural "%(left)s of %(total)s spots left"
msgstr[0] "%(left)s de %(total)s lugar libre"
msgstr[1] "%(left)s de %(total)s lugares libres"

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "Overlaps your %(time)s %(role)s shift"
msgstr "Se superpone con su turno de %(role)s (%(time)s)"

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "of %s volunteer spots are open."
msgstr "de %s lugares para voluntarios están disponibles."

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "Confirm my shift"
msgid_plural "Confirm my %s shifts"
msgstr[0] "Confirmar mi turno"
msgstr[1] "Confirmar mis %s turnos"

#: volunteers/static/volunteers/volunteer.js
msgid "Confirm my shifts"
msgstr "Confirmar mis turnos"

#: volunteers/static/volunteers/volunteer.js
msgid "No shifts chosen yet"
msgstr "Aún no ha elegido turnos"

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "Remove %s"
msgstr "Quitar %s"

#: volunteers/static/volunteers/volunteer.js
msgid "Enter your first name."
msgstr "Escriba su nombre."

#: volunteers/static/volunteers/volunteer.js
msgid "Enter your last name."
msgstr "Escriba su apellido."

#: volunteers/static/volunteers/volunteer.js
msgid "Enter an email address like name@example.com."
msgstr "Escriba un correo electrónico como nombre@ejemplo.com."

#: volunteers/static/volunteers/volunteer.js
msgid "Enter your email address."
msgstr "Escriba su correo electrónico."

#: volunteers/static/volunteers/volunteer.js
msgid "Enter a phone number with its area code."
msgstr "Escriba un número de teléfono con su código de área."

#: volunteers/static/volunteers/volunteer.js
msgid "Enter a phone number we can reach you on during the event."
msgstr "Escriba un número de teléfono donde podamos localizarle durante el evento."

#: volunteers/static/volunteers/volunteer.js
msgid "Confirm that you meet the age requirement."
msgstr "Confirme que cumple el requisito de edad."

#: volunteers/static/volunteers/volunteer.js
msgid "Tick the box to agree to the volunteer guidelines."
msgstr "Marque la casilla para aceptar las pautas para voluntarios."

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "Fix %s thing to finish signing up"
msgid_plural "Fix %s things to finish signing up"
msgstr[0] "Corrija %s dato para terminar su inscripción"
msgstr[1] "Corrija %s datos para terminar su inscripción"

#: volunteers/static/volunteers/volunteer.js
msgid "Confirming your shifts…"
msgstr "Confirmando sus turnos…"

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "%(shifts)s just filled up, so we took it off your schedule."
msgid_plural "%(shifts)s just filled up, so we took them off your schedule."
msgstr[0] "Ya no queda lugar en %(shifts)s, así que lo quitamos de su horario."
msgstr[1] "Ya no queda lugar en %(shifts)s, así que los quitamos de su horario."

#: volunteers/static/volunteers/volunteer.js
msgid "A shift is no longer available"
msgstr "Un turno ya no está disponible"

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "%s filled up while you were signing up."
msgstr "Mientras se inscribía, ya no quedó lugar en %s."

#: volunteers/static/volunteers/volunteer.js
msgid "Check this field."
msgstr "Revise este campo."

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "Your shift is confirmed, %(name)s."
msgid_plural "Your %(count)s shifts are confirmed, %(name)s."
msgstr[0] "Su turno está confirmado, %(name)s."
msgstr[1] "Sus %(count)s turnos están confirmados, %(name)s."

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "A copy is on its way to %s."
msgstr "Le enviamos una copia a %s."

#: volunteers/static/volunteers/volunteer.js
msgid "Add your shifts to your calendar so you have the times handy."
msgstr "Agregue sus turnos a su calendario para tener los horarios a mano."

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "Signed up. %s shift confirmed."
msgid_plural "Signed up. %s shifts confirmed."
msgstr[0] "Inscripción lista. %s turno confirmado."
msgstr[1] "Inscripción lista. %s turnos confirmados."

#: volunteers/static/volunteers/volunteer.js
msgid "Choose at least one shift."
msgstr "Elija al menos un turno."

#: volunteers/static/volunteers/volunteer.js
msgid "Your sign-up didn’t go through"
msgstr "No se pudo completar su inscripción"

#: volunteers/static/volunteers/volunteer.js
msgid "This page was open for a long time. Reload it, then pick your shifts again."
msgstr "Esta página estuvo abierta mucho tiempo. Vuelva a cargarla y elija sus turnos otra vez."

#: volunteers/static/volunteers/volunteer.js
msgid "Something went wrong on our side. Please try again in a minute."
msgstr "Algo salió mal de nuestro lado. Inténtelo de nuevo en un minuto."

#: volunteers/static/volunteers/volunteer.js
msgid "We couldn’t send your sign-up"
msgstr "No pudimos enviar su inscripción"

#: volunteers/static/volunteers/volunteer.js
msgid "Check your internet connection and try again. Your shifts are still selected."
msgstr "Revise su conexión a internet e inténtelo de nuevo. Sus turnos siguen seleccionados."

#: volunteers/static/volunteers/volunteer.js
msgid "Please try again in a minute."
msgstr "Inténtelo de nuevo en un minuto."

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "Added %s."
msgstr "Se agregó %s."

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "Removed %s."
msgstr "Se quitó %s."

#: volunteers/static/volunteers/volunteer.js
#, javascript-format
msgid "%s shift chosen."
msgid_plural "%s shifts chosen."
msgstr[0] "%s turno elegido."
msgstr[1] "%s turnos elegidos."

#: volunteers/static/volunteers/volunteer.js
msgid "Choose at least one shift to continue."
msgstr "Elija al menos un turno para continuar."
