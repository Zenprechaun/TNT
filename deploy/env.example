# Settings for the live website, one per line.
# setup_server.sh creates /srv/tahoetable/.env in this format, with a new secret key.
# After changing that file, restart the site: systemctl restart tahoetable

# Must be false on the live site.
DJANGO_DEBUG=false

# A long random value that keeps sign-ins secure. Never share it or put it in the code.
DJANGO_SECRET_KEY=replace-with-a-long-random-value

# The web addresses the site answers to, separated by commas.
DJANGO_ALLOWED_HOSTS=tahoeneighborhoodtable.com,www.tahoeneighborhoodtable.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tahoeneighborhoodtable.com,https://www.tahoeneighborhoodtable.com

# Where the database and the collected static files live, outside the code folder.
DJANGO_DB_PATH=/srv/tahoetable/data/db.sqlite3
DJANGO_STATIC_ROOT=/srv/tahoetable/static

# Once HTTPS works, set this to 31536000 (one year) so browsers always use HTTPS for the site.
DJANGO_HSTS_SECONDS=0

# Email. The easy way is the Management page on the site (/dashboard/manage/#email), which stores
# the email service's key encrypted and needs no restart. These lines are an alternative, used when
# the Management page has no email service. Fill them in from the service's SMTP settings, then
# restart the site.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=true
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# Organizers who hear about each new volunteer sign-up, separated by commas. This only fills in the
# Management page's list the first time; change it there afterwards.
# VOLUNTEER_NOTIFY_EMAILS=info@tahoeneighborhoodtable.com

# Optional: donations through Stripe. Without STRIPE_SECRET_KEY, the Donate button opens an email.
# Use the test key (sk_test_...) first, then the live key (sk_live_...). Never share it.
# After adding or changing it, restart the site and run: manage.sh connect_stripe
# STRIPE_SECRET_KEY=
# The EIN, printed on donation receipts.
# DONATIONS_TAX_ID=
# Receipts say donations are tax-deductible. Set to false if that stops being true.
# DONATIONS_TAX_DEDUCTIBLE=true
# Stripe's card fee, for the "cover the card fee" option. Change these if Stripe gives you a nonprofit rate.
# DONATION_FEE_PERCENT=2.9
# DONATION_FEE_CENTS=30
